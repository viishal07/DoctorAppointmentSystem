    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DoctorAppointmentSystem.API</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
